SELECT DISTINCT c.CustomerName, c.Email, c.PhoneNumber
FROM Customer c
JOIN Orders o ON c.CustomerID = o.CustomerID
WHERE o.OrderDate BETWEEN '2025-01-01' AND '2025-03-31';


SELECT DISTINCT c.CustomerName
FROM Customer c
JOIN Orders o ON c.CustomerID = o.CustomerID
JOIN OrderedItems oi ON o.OrderID = oi.OrderID
JOIN Book b ON oi.BookID = b.BookID
WHERE b.Title = 'The Art of War';


SELECT c.CustomerName, b.Title, oi.Quantity
FROM Customer c
JOIN Orders o ON c.CustomerID = o.CustomerID
JOIN OrderedItems oi ON o.OrderID = oi.OrderID
JOIN Book b ON oi.BookID = b.BookID;


SELECT AVG(OrderTotal) AS AverageAmountSpent
FROM
(
    SELECT OrderID, SUM(Quantity * PurchasePrice) AS OrderTotal
    FROM OrderedItems
    GROUP BY OrderID
) AS OrderTotals;


SELECT TOP 1 c.CustomerName,
SUM(oi.Quantity * oi.PurchasePrice) AS TotalSpent
FROM Customer c
JOIN Orders o ON c.CustomerID = o.CustomerID
JOIN OrderedItems oi ON o.OrderID = oi.OrderID
GROUP BY c.CustomerName
ORDER BY TotalSpent DESC;
