CREATE DATABASE Cinema;


CREATE TABLE Customer(
CustomerID INT IDENTITY(1,1) UNIQUE NOT NULL,
CustomerName VARCHAR(50) NOT NULL,
ContactNo VARCHAR(10) NOT NULL,
Email VARCHAR(50) NOT NULL,
PRIMARY KEY(CustomerID)
);

CREATE TABLE Booking(
BookingID INT IDENTITY(1,1) UNIQUE NOT NULL,
NumTickets INT NOT NULL,
BookingDate Date NOT NULL,
BookingTime TIME NOT NULL,
CustomerID INT NOT NULL,
PRIMARY KEY(BookingID),
FOREIGN KEY(CustomerID) REFERENCES Customer(CustomerID)
);

CREATE TABLE Movie(
MovieID INT IDENTITY(1,1) UNIQUE NOT NULL,
Title VARCHAR(50) NOT NULL,
GENRE VARCHAR(100)NOT NULL,
Duration INT NOT NULL,
Age INT NOT NULL,
Price DECIMAL(10,2) NOT NULL,
PRIMARY KEY(MovieID)
);

CREATE TABLE MovieBooking(
MovieBookingID INT IDENTITY(1,1) UNIQUE NOT NULL,
MovieID INT NOT NULL,
BookingID INT NOT NULL,
BookingDate Date NOT NULL,
PRIMARY KEY(MovieBookingID),
FOREIGN KEY(MovieID) REFERENCES Movie(MovieID),
FOREIGN KEY(BookingID) REFERENCES Booking(BookingID)
);



