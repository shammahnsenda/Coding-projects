SELECT AVG(Price) AS AveragePrice
FROM Movie;


SELECT DISTINCT c.*
FROM Customer c
INNER JOIN Booking b ON c.CustomerID = b.CustomerID
INNER JOIN MovieBooking mb ON mb.BookingID = b.BookingID
INNER JOIN Movie m ON mb.MovieID = m.MovieID 
WHERE m.Title ='Project Hail Mary';


SELECT c.*
FROM Customer c
INNER JOIN Booking b ON c.CustomerID = b.CustomerID
INNER JOIN MovieBooking mb ON mb.BookingID = b.BookingID
WHERE mb.BookingDate BETWEEN '2025-12-01' AND '2025-12-31';


SELECT c.CustomerName,SUM(b.NumTickets) AS [Total Tickets]
FROM Customer c 
INNER JOIN Booking b ON c.CustomerID = b.CustomerID
GROUP BY c.CustomerName;


SELECT c.CustomerName
FROM 
	(Select MovieID , Count(Title) as Total
	 FROM Movie Group by MovieID
	 )as Counting, Customer c

INNER JOIN Booking b ON c.CustomerID = b.CustomerID
INNER JOIN MovieBooking mb ON mb.BookingID = b.BookingID
INNER JOIN Movie m ON mb.MovieID = m.MovieID
Where Total > 1
GROUP BY c.CustomerName ;
