    </Target>
    <Target Name="farming_u:Make">
        <MSBuild Projects="farming_u.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FarmingSystem_p;farming_u"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FarmingSystem_p:Clean;farming_u:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FarmingSystem_p:Make;farming_u:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
