Create Database Finance;

CREATE TABLE Advisor (
    RegistrationNumber CHAR(7) PRIMARY KEY,
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL
);

CREATE TABLE Client (
    ClientID INT PRIMARY KEY ,
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL,
    ContactNumber VARCHAR(15) NOT NULL
);

CREATE TABLE Consultation (
    ConsultationID INT PRIMARY KEY ,
    Date DATE NOT NULL,
    Time TIME NOT NULL,
    RegistrationNumber CHAR(7),
    ClientID INT,
    FOREIGN KEY (RegistrationNumber) REFERENCES Advisor(RegistrationNumber),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID)
);

CREATE TABLE Invoice (
    InvoiceID INT PRIMARY KEY ,
    Amount DECIMAL(10,2) NOT NULL,
    Status VARCHAR(10) ,
    ConsultationID INT UNIQUE,
    FOREIGN KEY (ConsultationID) REFERENCES Consultation(ConsultationID)
);

