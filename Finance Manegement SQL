SELECT A.FirstName, A.LastName, COUNT(C.ConsultationID) AS TotalConsultations
FROM Advisor A
JOIN Consultation C 
    ON A.RegistrationNumber = C.RegistrationNumber
GROUP BY A.RegistrationNumber, A.FirstName, A.LastName
HAVING COUNT(C.ConsultationID) = (
    SELECT MAX(ConsultCount)
    FROM (
        SELECT COUNT(*) AS ConsultCount
        FROM Consultation
        GROUP BY RegistrationNumber
    ) AS Temp
);

SELECT 
    C.ConsultationID,
    C.Date,
    C.Time,
    A.FirstName AS AdvisorFirstName,
    A.LastName AS AdvisorLastName,
    CL.FirstName AS ClientFirstName,
    CL.LastName AS ClientLastName
FROM Consultation C
JOIN Advisor A 
    ON C.RegistrationNumber = A.RegistrationNumber
JOIN Client CL 
    ON C.ClientID = CL.ClientID
WHERE C.Date BETWEEN 
    DATEADD(day, 7, CAST(GETDATE() AS date))
    AND DATEADD(day, 14, CAST(GETDATE() AS date))
ORDER BY C.Date, C.Time;

SELECT 
    CL.ClientID,
    CL.FirstName,
    CL.LastName,

    SUM(I.Amount) AS TotalPastDueAmount,

    SUM(
        I.Amount * 
        CASE 
            WHEN DATEDIFF(day, DATEADD(day, 28, C.Date), GETDATE()) > 0
            THEN DATEDIFF(day, DATEADD(day, 28, C.Date), GETDATE())
            ELSE 0
        END * 0.005
    ) AS TotalInterest,

    SUM(
        I.Amount + 
        (I.Amount * 
            CASE 
                WHEN DATEDIFF(day, DATEADD(day, 28, C.Date), GETDATE()) > 0
                THEN DATEDIFF(day, DATEADD(day, 28, C.Date), GETDATE())
                ELSE 0
            END * 0.005)
    ) AS TotalAmountDue

FROM Client CL
JOIN Consultation C 
    ON CL.ClientID = C.ClientID
JOIN Invoice I 
    ON C.ConsultationID = I.ConsultationID
WHERE 
    I.Status = 'Unpaid'
GROUP BY 
    CL.ClientID, CL.FirstName, CL.LastName
ORDER BY 
    TotalAmountDue DESC;
